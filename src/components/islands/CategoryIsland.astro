---
import DemoCategoryArchive from '../demo/DemoCategoryArchive.astro';
import { listBlogs } from '../../lib/data';
const { category, page: requestedPage = 1 } = Astro.props;
const slug = category?._sys?.filename || '';
const page = Math.max(1, Number(requestedPage) || 1);
const normalize=(v:any)=>String(typeof v==='string'?v:(v?._sys?.filename||v?.title||'')).split('/').pop()?.replace(/\.(json|mdx?)$/,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
const allPosts=(await listBlogs()).filter((post:any)=>{
 const categoryValues=Array.isArray(post.categories)?post.categories:(post.categories&&typeof post.categories==='object'?Object.entries(post.categories).sort(([left],[right])=>left.localeCompare(right)).map(([,value])=>value):[]);
 const relationshipSlots=Object.entries(post||{}).filter(([key,value])=>/^category\d{2}$/.test(key)&&value).sort(([left],[right])=>left.localeCompare(right)).map(([,value])=>value);
 const refs=(categoryValues.length?categoryValues:relationshipSlots).concat(post.category?[post.category]:[]).map((ref:any)=>ref?.category||ref);
 return refs.some((ref:any)=>normalize(ref)===normalize(slug));
});
const posts=allPosts.slice((page-1)*6,page*6);
const totalPages=Math.max(1,Math.ceil(allPosts.length/6));
---
<DemoCategoryArchive archiveTitle={category?.title || 'Category'} category={category} posts={posts} currentPage={page} totalPages={totalPages} basePath={`/${slug}`} />
