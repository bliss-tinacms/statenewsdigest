---
import { tinaField } from '@tinacms/astro/tina-field';
import pageHtml from '../../data/demo-html/page.html?raw';
import { renderDefaultPageDemo } from '../../lib/state-news-demo-render';

const { data, config = null } = Astro.props;
const html = renderDefaultPageDemo(pageHtml, {
  page: data,
  config,
  fields: data ? {
    title: tinaField(data, 'title'),
    sections: (data.authoritySections || []).map((section: any) => ({ heading: tinaField(section, 'heading'), body: tinaField(section, 'body') })),
  } : {},
});
---
<Fragment set:html={html} />
