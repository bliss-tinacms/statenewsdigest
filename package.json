{
  "name": "statenewsdigest",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm validate:starter && tinacms dev -c \"astro dev\"",
    "start": "node ./app.mjs",
    "build": "pnpm validate:site && node scripts/tina-build-safe.mjs",
    "build:local": "pnpm validate:starter && node scripts/tina-build-safe.mjs --local",
    "sanitize:generated": "node scripts/sanitize-generated-client.mjs",
    "site:provision": "node scripts/provision-site.mjs",
    "runtime:install": "node scripts/install-runtime-env.mjs",
    "runtime:test": "node scripts/test-runtime-env.mjs",
    "validate:starter": "node scripts/validate-starter.mjs && pnpm test:seo-contract && pnpm test:seo-contract:negative && pnpm runtime:test",
    "test:seo-contract": "node scripts/test-seo-contract.mjs",
    "test:seo-contract:negative": "node scripts/test-seo-contract-negative.mjs",
    "seo:audit": "python3 scripts/seo-route-audit.py",
    "publisher:gate": "node scripts/publisher-admin-gate.cjs",
    "validate:site": "node scripts/validate-starter.mjs --runtime && pnpm test:seo-contract && pnpm test:seo-contract:negative",
    "build:search": "tinacms search-index",
    "preview": "astro preview",
    "astro": "astro",
    "permalink:sync": "node scripts/sync-permalinks-to-filenames.mjs",
    "permalink:watch": "node scripts/watch-permalinks-to-filenames.mjs",
    "tina:fullcheck": "python3 scripts/tina-fullcheck.py",
    "astro:demo-lock:preflight": "node scripts/validate-demo-lock-preflight.mjs",
    "astro:demo-lock:preflight:negative": "node scripts/test-demo-lock-preflight-negative.mjs",
    "astro:demo-lock": "node scripts/validate-demo-lock.mjs",
    "astro:demo-lock:negative": "node scripts/test-demo-lock-negative.mjs",
    "core:gate-zero": "node scripts/validate-core-gate-zero.mjs .migration/core-gate-zero-ledger.json references/CORE-GATE-0-RESOURCE-POLICY.json",
    "core:gate-zero:negative": "node scripts/test-core-gate-zero-negative.mjs",
    "migration:contracts": "node scripts/validate-migration-contracts.mjs --contract all",
    "migration:contracts:negative": "node scripts/test-migration-contracts-negative.mjs",
    "category:contract": "node scripts/validate-migration-contracts.mjs --contract category",
    "category:contract:negative": "node scripts/test-migration-contracts-negative.mjs",
    "test:migration-rebrand-ui": "node scripts/validate-migration-contracts.mjs --contract rebrand && node scripts/validate-migration-contracts.mjs --contract responsive && node scripts/validate-migration-contracts.mjs --contract islands",
    "test:migration-rebrand-ui:negative": "node scripts/test-migration-contracts-negative.mjs",
    "test:author-island": "node scripts/validate-migration-contracts.mjs --contract author",
    "test:author-island:negative": "node scripts/test-migration-contracts-negative.mjs",
    "test:media-contract": "node scripts/validate-migration-contracts.mjs --contract media",
    "test:media-contract:negative": "node scripts/test-migration-contracts-negative.mjs",
    "migration:completion": "node scripts/validate-migration-completion.mjs .migration/completion-manifest.json",
    "migration:completion:negative": "node scripts/test-migration-completion-negative.mjs",
    "media:rehome": "python3 scripts/rehome-demo-assets.py",
    "validate:migration": "pnpm core:gate-zero && pnpm core:gate-zero:negative && pnpm migration:contracts && pnpm migration:contracts:negative && pnpm astro:demo-lock:preflight && pnpm astro:demo-lock:preflight:negative && pnpm astro:demo-lock && pnpm astro:demo-lock:negative && pnpm test:seo-contract && pnpm test:seo-contract:negative && pnpm runtime:test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/mdx": "^6.0.2",
    "@astrojs/netlify": "^7.0.13",
    "@astrojs/node": "^10.1.4",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^10.0.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@iconify-json/tabler": "^1.2.35",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@tinacms/astro": "^0.5.1",
    "@tinacms/auth": "^1.1.3",
    "astro": "^6.4.4",
    "astro-icon": "^1.1.5",
    "cheerio": "1.2.0",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "next-tinacms-cloudinary": "^27.0.4",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "tinacms": "^3.14.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tinacms/cli": "^2.6.1",
    "@tinacms/graphql": "^2.4.10",
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "1.56.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^7.3.2"
  }
}
